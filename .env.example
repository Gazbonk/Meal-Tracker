# Copy this to .env in the repo root before running `docker compose up`.
# This is separate from server/.env.example, which is only for local
# (non-Docker) development.

# Keep this pointed at the bind-mounted volume so the database survives
# container rebuilds.
DATABASE_URL="file:/app/data/prod.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000

# CLIENT_ORIGIN doesn't matter much here since the client is served from
# the same origin as the API in this single-container setup, but CORS
# still needs a value.
CLIENT_ORIGIN="http://localhost:4000"

# Used once, only if the database has no users yet, to create your first
# (admin) account. Change the password before you first start the stack.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Gareth"
HOUSEHOLD_NAME="Hornsby Household"

# Only needed if you're exposing this at a public domain via Cloudflare
# Tunnel (see README). Leave blank otherwise. Get this from the Cloudflare
# Zero Trust dashboard when you create the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=""

# Optional. Recipe import from a URL always tries schema.org Recipe markup
# first (free). Set this to also fall back to AI-assisted extraction for
# pages without that markup (e.g. Substack posts) — costs a small amount
# per import (uses Claude Haiku). Leave blank to skip the fallback.
ANTHROPIC_API_KEY=""
