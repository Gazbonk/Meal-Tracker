DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Signup is disabled. If the database has no users yet, these are used
# to create the first (admin) account on server startup. Not used again
# once at least one user exists — manage further accounts from /admin.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_NAME="Gareth"
HOUSEHOLD_NAME="Hornsby Household"

# Optional. Recipe import from a URL always tries schema.org Recipe markup
# first (free). Set this to also fall back to AI-assisted extraction for
# pages without that markup (e.g. Substack posts) — costs a small amount
# per import (uses Claude Haiku). Leave blank to skip the fallback.
ANTHROPIC_API_KEY=""
